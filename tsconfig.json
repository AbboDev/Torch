{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "module": "esnext",
    "strict": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "noImplicitAny": false,
    "typeRoots": [
      "./node_modules/phaser/types",
      "./node_modules/@types",
      "./src/@types"
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["./src/**/*", "./tests/**/*"]
}
