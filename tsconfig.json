{
  "compilerOptions": {
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "module": "esnext",
    "strict": true,
    "sourceMap": true,
    "noEmit": true,
    "allowJs": true,
    "noImplicitAny": false,
    "typeRoots": [
      "./node_modules/phaser/types",
      "./node_modules/@types",
      "./src/@types"
    ],
    "paths": {
      "Config/*": ["./src/Config/*"],
      "Entities/Bullets/*": ["./src/Entities/Bullets/*"],
      "Entities/Hitboxes/*": ["./src/Entities/Hitboxes/*"],
      "Entities/Weapons/*": ["./src/Entities/Weapons/*"],
      "Entities/*": ["./src/Entities/*"],
      "Miscellaneous": ["./src/Miscellaneous/index.ts"],
      "Miscellaneous/*": ["./src/Miscellaneous/*"],
      "HUD/*": ["./src/HUD/*"],
      "Scenes": ["./src/Scenes/index.ts"],
      "Scenes/*": ["./src/Scenes/*"]
    }
  },
  "include": ["./src/**/*"]
}
