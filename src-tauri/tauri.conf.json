{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Torch",
  "version": "1.0.1",
  "identifier": "com.abbodev.torch",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Torch",
        "width": 960,
        "height": 540,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 480,
        "minHeight": 270
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
